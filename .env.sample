# INFRA
DATABASE_URL=postgresql://database_user:database_password@localhost:port/database_name?schema=public
JWT_SECRET=
APP_KEY=

# SERVER
PORT=3000
HOST=127.0.0.1
DOMAIN=localhost
HTTPS=true
WORKERS=4

# OTHER
APP_NAME="Samambaia API"
RUST_ENV=DEVELOPMENT
RUST_LOG=info
COMPOSE_PROFILES=dev
APP_URL=http://$DOMAIN:$PORT

## Redis
REDIS_PASSWORD=12345 
# don't change this one: it's readonly
REDIS_USER=redis
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL=redis://redis:12345@localhost:6379
# optional field
REDIS_CLIENT_CERT_PATH=
# optional field
REDIS_CLIENT_KEY_PATH=
# optional field
REDIS_ROOT_CERT_PATH=

# optional field
# defaults to 4
JOB_QUEUE_WORKERS=
